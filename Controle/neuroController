class NeuroController:
    def __init__(self, input_size=1, hidden_size=5, output_size=1):
        # Pesos da Rede Neural
        self.W1 = np.random.randn(input_size, hidden_size) * 0.1
        self.b1 = np.zeros((1, hidden_size))
        self.W2 = np.random.randn(hidden_size, output_size) * 0.1
        self.b2 = np.zeros((1, output_size))

    # Função de Ativação Tanh
    def tanh(self, z):
        return np.tanh(z)

    def derivada_tanh(self, a):
        return 1.0 - np.tanh(a)**2

    def forward(self, erro):
        # Transforma o erro escalar em formato de matriz
        X = np.array([[erro]])

        # Passada pela rede neural
        self.Z1 = np.dot(X, self.W1) + self.b1
        self.A1 = self.tanh(self.Z1) # Ativação da camada oculta

        self.Z2 = np.dot(self.A1, self.W2) + self.b2
        self.Output = self.Z2

        return self.Output[0, 0] # Retorna o sinal de controle (U)

    def backpropagation(self, erro_sistema, dy_du, learn_ratio):
        X = np.array([[erro_sistema]])

        # O gradiente da perda em relação ao controle (U)
        # dLoss/du = (dLoss/dy) * (dy/du) = -erro_sistema * b_one
        d_Output = np.array([[-erro_sistema * dy_du]])

        # Atualizando a Camada de Saída
        dW2 = np.dot(self.A1.T, d_Output)
        db2 = np.sum(d_Output, axis=0, keepdims=True)

        # Propagando para a Camada Oculta
        d_A1 = np.dot(d_Output, self.W2.T)
        d_Z1 = d_A1 * self.derivada_tanh(self.Z1)

        dW1 = np.dot(X.T, d_Z1)
        db1 = np.sum(d_Z1, axis=0, keepdims=True)

        # Descida do gradiente
        self.W1 -= learn_ratio * dW1
        self.b1 -= learn_ratio * db1
        self.W2 -= learn_ratio * dW2
        self.b2 -= learn_ratio * db2
