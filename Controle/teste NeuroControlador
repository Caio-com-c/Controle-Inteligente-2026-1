import numpy as np
import matplotlib.pyplot as plt

from plant import Plant
from neuroController import NeuroController

tempo_total = 50.0
dt = 0.01
passos = int(tempo_total / dt)

historico_tempo = np.linspace(0, tempo_total, passos)
historico_valor = np.zeros(passos)
historico_controle = np.zeros(passos)

k = 40/13334
tau = 7
planta = Plant()
planta2 = Plant()
planta.set_order_one(dt=dt, tau=tau, k=k)
planta2.set_order_one(dt=dt, tau=tau, k=k)

# Cria a Rede Neural com 5 neurônios ocultos
controlador_nn = NeuroController(input_size=1, hidden_size=5, output_size=1)

setpoint = 35
valor_sistema = 0.0
taxa_aprendizado = 20
sat_limit = 13334
plant_h = []

for i in range(passos):
    if i >= passos/2:
      setpoint = setpoint

    historico_valor[i] = valor_sistema

    erro = setpoint - valor_sistema

    # 1. A Rede Neural recebe o erro e a força de controle U
    forca_controle_sugerida = controlador_nn.forward(erro) * sat_limit

    # Saturador
    if forca_controle_sugerida > sat_limit:
        forca_controle = sat_limit
    elif forca_controle_sugerida <= 0:
        forca_controle = 0
    else:
        forca_controle = forca_controle_sugerida

    historico_controle[i] = forca_controle

    # 2. A Planta física reage
    valor_sistema = planta.order_one(forca_controle)
    plant_h.append(planta2.order_one(13334))

    # 3. A Rede Neural aprende com o erro e ajusta suas sinapses
    controlador_nn.backpropagation(erro, dy_du=planta.b_one, learn_ratio=taxa_aprendizado)

plt.style.use('dark_background')
fig, (ax1, ax2) = plt.subplots(2, 1, figsize=(10, 8))

ax1.plot(historico_tempo, historico_valor, color='cyan', label='Saída (Y)')
ax1.plot(historico_tempo, plant_h, color='blue', label='Planta (Y)')
ax1.axhline(setpoint, color='red', linestyle='--', label='Setpoint')
ax1.set_title('Planta controlada por Rede Neural')
ax1.legend()
ax1.grid(True, alpha=0.3)

ax2.plot(historico_tempo, historico_controle, color='magenta', label='Sinal de Controle (U) gerado pela NN')
ax2.set_xlabel('Tempo (s)')
ax2.legend()
ax2.grid(True, alpha=0.3)

plt.tight_layout()
plt.show()
